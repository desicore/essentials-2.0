                      "name": "Cause",
                      "fill": "$accent",
                      "content": "THE SOFTWARE FEELS COMPLEX",
                      "fontFamily": "$font",
                      "fontSize": 20,
                      "fontWeight": "700",
                      "letterSpacing": 2
                    },
                    {
                      "type": "text",
                      "id": "Z7X9t",
                      "name": "Quote",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "“Once you learn the interface, it makes sense, but it's complex.”",
