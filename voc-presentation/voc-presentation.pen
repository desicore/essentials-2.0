                      "fontFamily": "$font",
                      "fontSize": 20,
                      "fontWeight": "700",
                      "letterSpacing": 2
                    },
                    {
                      "type": "text",
                      "id": "GHQi1",
                      "name": "Quote",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "“It is a lot of work to be in LearningSpace and run the sim at the same time. We just don't have enough manpower.”",
                      "lineHeight": 1.25,
                      "fontFamily": "$font",
                      "fontSize": 30,
                      "fontWeight": "600",
                      "letterSpacing": -0.3
                    },
                    {
                      "type": "frame",
                      "id": "v8c8Cb",
                      "name": "Spacer",
                      "width": "fill_container",
                      "height": "fill_container"
                    },
                    {
                      "type": "text",
                      "id": "hhs1y",
                      "name": "Source",
                      "fill": "$muted-dark",
                      "content": "— Simulation staff, John Carroll University",
                      "fontFamily": "$font",
                      "fontSize": 20,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "ocmRi",
                  "name": "Quote They log in rarely",
                  "width": "fill_container",
                  "height": "fill_container",
                  "fill": "$tile",
                  "cornerRadius": 28,
                  "layout": "vertical",
                  "gap": 16,
                  "padding": [
                    36,
                    40
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "a6yKqn",
                      "name": "Cause",
                      "fill": "$accent",
                      "content": "THEY LOG IN RARELY",
                      "fontFamily": "$font",
                      "fontSize": 20,
                      "fontWeight": "700",
                      "letterSpacing": 2
                    },
                    {
                      "type": "text",
                      "id": "TS7j7",
                      "name": "Quote",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "“The system is not that difficult to use. It's just when you don't use it a lot, remembering how everything functions separately.”",
                      "lineHeight": 1.25,
                      "fontFamily": "$font",
                      "fontSize": 30,
                      "fontWeight": "600",
                      "letterSpacing": -0.3
                    },
                    {
                      "type": "frame",
                      "id": "QOpxL",
                      "name": "Spacer",
