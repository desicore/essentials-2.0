          "children": [
            {
              "id": "cdqOA",
              "type": "ref",
              "ref": "jOLjd",
              "name": "Note",
              "descendants": {
                "eGDow": {
                  "content": "REF: Podia – one 'Add' menu for every material type; Teachable – local, cloud and URL sources unified. Dropbox Dash – preview without losing context."
                }
              }
            },
            {
              "id": "NmLL0",
              "type": "ref",
              "ref": "jOLjd",
              "name": "Note",
              "descendants": {
                "eGDow": {
                  "content": "REF: Squarespace – draft / published / scheduled visible in the outline. Teachable – release timing separate from publication."
                }
              }
            },
            {
              "id": "Z0cTd",
              "type": "ref",
              "ref": "jOLjd",
              "name": "Note",
              "descendants": {
                "eGDow": {
                  "content": "REF: Podia – status, access and discoverability as three separate controls. Figma – invitations, link and levels in one share dialog."
                }
              }
            },
            {
              "id": "i1gVC4",
              "type": "ref",
              "ref": "jOLjd",
              "name": "Note",
              "descendants": {
                "eGDow": {
                  "content": "HYPOTHESIS: materials reach learners through the portal, a link, or a push to Canvas – never as email attachments. This is the fix for John Carroll re-shooting video."
                }
              }
            },
            {
              "id": "Asfgr",
              "type": "ref",
              "ref": "jOLjd",
              "name": "Note",
              "descendants": {
                "eGDow": {
                  "content": "OPEN: reuse across courses – link or copy? Wireframe shows link."
                }
              }
            },
            {
              "id": "AV8FO",
              "type": "ref",
              "ref": "jOLjd",
              "name": "Note",
              "descendants": {
                "eGDow": {
                  "content": "DON'T BUILD: Gumroad's single freeform content document; Podia's hidden toggle in a row overflow menu; per-file permission grids."
                }
              }
            }
          ]
        }
      }
