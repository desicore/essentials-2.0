                  "content": "REF: Riverside / incident.io — explicit SSO failure with retry and contact routes kept on screen."
                }
              }
            },
            {
              "id": "ggGNA",
              "type": "ref",
              "ref": "jOLjd",
              "name": "Note 5",
              "descendants": {
                "eGDow": {
                  "content": "REF: Microsoft Copilot / Surfshark — code fallback instead of lockout. This is the John Carroll six-month-lockout fix."
                }
              }
            },
            {
              "id": "NfPDB",
              "type": "ref",
              "ref": "jOLjd",
              "name": "Note 6",
              "descendants": {
