                  "content": "REF: Atlassian — JIT: create accounts at first SAML sign-in as an explicit policy."
                }
              }
            },
            {
              "id": "hk9oa",
              "type": "ref",
              "ref": "jOLjd",
              "name": "Note 4",
              "descendants": {
