            {
              "id": "WPX1y",
              "type": "ref",
              "ref": "jOLjd",
              "name": "Note 1",
              "descendants": {
                "eGDow": {
                  "content": "HYPOTHESIS: 3 roles (Admin, Staff, Learner) replace 8 global roles. Content scope, not role, decides what Staff can touch."
                }
              }
            },
            {
              "id": "FCP1O",
              "type": "ref",
              "ref": "jOLjd",
              "name": "Note 2",
              "descendants": {
                "eGDow": {
                  "content": "HYPOTHESIS: staff never set passwords. Invite by email or provision via SSO/Canvas. Status: Invited → Active → Deactivated."
                }
              }
            },
            {
              "id": "VL3lg",
              "type": "ref",
              "ref": "jOLjd",
              "name": "Note 3",
              "descendants": {
                "eGDow": {
                  "content": "REF: Miro / Linear — one paste box handles 1 or 100 emails; rows exist before anyone accepts."
                }
              }
            },
            {
              "id": "OrJZ3",
              "type": "ref",
              "ref": "jOLjd",
              "name": "Note 4",
              "descendants": {
                "eGDow": {
                  "content": "REF: Loom — deactivation explains what is lost, what stays, who takes over. Entra — disable, don't delete."
                }
              }
            },
            {
              "id": "heiXV",
              "type": "ref",
              "ref": "jOLjd",
              "name": "Note 5",
              "descendants": {
                "eGDow": {
                  "content": "REF: Expensify — role as inline segmented control. Twist — consequence text on downgrade. GitHub — unlink a wrong SSO identity."
                }
              }
            },
            {
              "id": "RIZvL",
              "type": "ref",
              "ref": "jOLjd",
              "name": "Note 6",
              "descendants": {
                "eGDow": {
                  "content": "DON'T BUILD: Dovetail-style accept page (full name + 12-char password before entry); per-user permission grid."
                }
              }
            }
          ]
        }
